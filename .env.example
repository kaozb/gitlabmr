# ===== Django =====
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=gitlabmr.example.com

# ===== 控制台访问保护 =====
# 主通道：企业微信扫码/免密登录（固定接入信息内置在 reviewer/wework.py，应用名 userai）
# 后备通道：以下访问密码（应急用，如企微中转服务故障）；留空则密码通道关闭，仅企微可登录
GITLABMR_UI_PASSWORD=

# ===== GitLab webhook 验签 =====
# 服务端不做共享密钥验签（原 GITLABMR_WEBHOOK_SECRET 已移除），请部署在可信内网；
# 未匹配到令牌的仓库会被直接忽略。

# ===== 多仓库令牌：YAML 文件或内联 JSON，二选一 =====
# 文件格式见 README；match_url 是 GitLab URL 前缀（匹配依据，最长者生效），product 仅作展示：
# repos:
#   - match_url: https://gitlab.example.com/tp/CNEOSv2
#     product: CNEOSv2
#     token: glpat-xxxx
GITLABMR_REPO_CONFIG=/path/to/repo_tokens.yml
# 或者（JSON 字符串）：
# GITLABMR_REPO_TOKENS=[{"match_url":"https://gitlab.example.com/tp/CNEOSv2","product":"CNEOSv2","token":"glpat-xxxx"}]
# 没有 API 地址命中时的兜底（也作为默认令牌的匹配地址）：
GITLABMR_GITLAB_URL=https://gitlab.com
GITLABMR_GITLAB_TOKEN=

# ===== LLM（OpenAI 兼容 /chat/completions）=====
GITLABMR_LLM_BASE_URL=https://api.deepseek.com/v1
GITLABMR_LLM_API_KEY=sk-xxx
GITLABMR_MODEL=deepseek-chat
GITLABMR_FALLBACK_MODELS=deepseek-chat,gpt-4o-mini

# ===== 评审行为 =====
GITLABMR_MAX_DIFF_TOKENS=24000
GITLABMR_NUM_MAX_FINDINGS=6
GITLABMR_INLINE_COMMENTS=false
# 行内评论硬上限（代码内 MAX_INLINE_COMMENTS=10 再兜底，配置无法突破）；0 = 全部进总结评论
GITLABMR_INLINE_MAX_COMMENTS=10
GITLABMR_REVIEW_ON_PUSH=true
GITLABMR_IGNORE_BRANCHES=
GITLABMR_LANGUAGE=zh-CN
GITLABMR_MAX_COMMENT_CHARS=60000
GITLABMR_WORKERS=2
GITLABMR_LOG_LEVEL=INFO

# ===== 上下文增强（第一层：纯 GitLab API 补充上下文，无需克隆仓库）=====
# 评审时用 repository files/raw API 拉取变更文件全文、用 blobs 搜索查询
# diff 中定义符号的全库引用，让模型对"未使用/缺少调用方"类问题能查证而不是臆断。
# 全部尽力而为：单个文件/搜索失败自动跳过，API 整体不可用则退化为仅 diff 评审。
GITLABMR_CONTEXT_ENRICHMENT=true
# 最多补全文多少个变更文件（patch 小的优先，全文带行号供模型引用证据）
GITLABMR_CONTEXT_MAX_FILES=6
# 单个补全文件的最大字符数
GITLABMR_CONTEXT_MAX_FILE_CHARS=20000
# 最多对多少个 diff 中定义的符号做全库引用搜索
# （需要 GitLab 实例启用高级搜索；未启用时自动跳过，不影响其余流程）
GITLABMR_CONTEXT_MAX_SYMBOLS=8
# 模型主动索要上下文的轮数：模型可返回 need_context（要文件/要符号），
# 服务端调 GitLab API 取回后再次送评，直到预算用尽（0 = 关闭）
GITLABMR_CONTEXT_FETCH_ROUNDS=1
